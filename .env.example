# Copy to .env next to compose.yaml. Not secret; secrets go in ./secrets/.
MFP_USER=your-mfp-username
MFP_PUBLIC_HOST=mfp.example.com
# IANA timezone that defines "today" and the nightly sync time, e.g. America/New_York
MFP_TZ=UTC
# Two-letter country for MFP's food database search, e.g. US, GB, CA, AU
MFP_COUNTRY=US
MFP_NIGHTLY_AT=03:30
# uid/gid that owns ./data and ./secrets on the host (`id -u`, `id -g`)
PUID=1000
PGID=1000
